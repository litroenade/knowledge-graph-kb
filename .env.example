# Backend runtime reference.
# This file is not loaded by the application. Runtime overrides come from the root `.env` file or shell environment variables.

# Runtime storage
KB_DATA_DIR=./data/kb
KB_DATABASE_NAME=kb.sqlite3
KB_VECTOR_INDEX_DIR_NAME=vector_index
KB_UPLOAD_DIR_NAME=uploads
KB_SECRET_DIR_NAME=secrets
MODEL_CONFIG_SECRET_NAME=model_config.key
KB_SCAN_ROOTS=["./data/kb/uploads"]

# Backend server
FRONTEND_DIST_DIR=./frontend/dist
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Model provider / API key are stored in the local database and secret file.
# Do not put provider, model, or API key settings in .env.

# Retrieval / chunking defaults
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=120
QUERY_CONTEXT_CHUNKS=6
QUERY_RRF_K=60
QUERY_STRUCTURED_SHORT_CIRCUIT_HITS=3
QUERY_PPR_ENABLED=false
QUERY_PPR_MIN_HITS=5
QUERY_PPR_CANDIDATE_LIMIT=30
QUERY_HISTORY_TURNS=3
